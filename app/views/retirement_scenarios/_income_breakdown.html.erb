<%# locals: (scenario:) %>
<section class="bg-container shadow-border-xs rounded-xl p-4 space-y-3">
  <h2 class="text-lg font-medium text-primary">Income Breakdown</h2>

  <div class="space-y-3">
    <!-- Monthly Expenses -->
    <div class="flex justify-between">
      <span class="font-medium text-primary">Monthly Retirement Expenses</span>
      <span class="text-primary"><%= format_money Money.new(scenario.retirement_monthly_expenses || 0, scenario.family.currency) %></span>
    </div>

    <!-- Pension Sources -->
    <div class="border-t border-divider pt-3">
      <p class="font-medium text-primary mb-2">Pension Income Sources</p>

      <% scenario.retirement_scenario_persons.includes(:person).each do |rsp| %>
        <% if rsp.state_pension_monthly.present? && rsp.state_pension_monthly > 0 %>
          <div class="flex justify-between text-sm">
            <span class="text-secondary">State Pension (<%= rsp.person.first_name %>)</span>
            <span class="text-primary"><%= format_money Money.new(rsp.state_pension_monthly, scenario.family.currency) %>/mo</span>
          </div>
        <% end %>
      <% end %>

      <% scenario.pension_sources.with_payout.includes(:account).each do |ps| %>
        <div class="flex justify-between text-sm">
          <span class="text-secondary"><%= ps.account.name %> (<%= ps.account.subtype&.humanize %>)</span>
          <span class="text-primary"><%= format_money Money.new(ps.expected_monthly_payout || 0, scenario.family.currency) %>/mo</span>
        </div>
      <% end %>

      <%
        total_pension = scenario.calculate_total_pension_income
        expenses = (scenario.retirement_monthly_expenses || 0).to_f
        coverage = expenses > 0 ? (total_pension / expenses * 100).round(0) : 0
      %>
      <div class="flex justify-between font-medium border-t border-divider mt-2 pt-2">
        <span class="text-primary">Total Pension Income</span>
        <span class="text-primary">
          <%= format_money Money.new(total_pension, scenario.family.currency) %>/mo
          <span class="text-sm text-secondary">(<%= coverage %>% coverage)</span>
        </span>
      </div>
    </div>

    <!-- Gap Analysis -->
    <% gap = expenses - total_pension %>
    <div class="border-t border-divider pt-3">
      <div class="flex justify-between font-medium">
        <span class="text-primary">Portfolio Must Cover</span>
        <% if gap <= 0 %>
          <span class="text-green-600">
            <%= icon("check", class: "w-4 h-4 inline") %> Pensions fully cover expenses
          </span>
        <% else %>
          <span class="text-primary"><%= format_money Money.new(gap, scenario.family.currency) %>/mo</span>
        <% end %>
      </div>
    </div>
  </div>
</section>
