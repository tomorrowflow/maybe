<%# locals: (scenario:, analysis:) %>
<div class="space-y-6">
  <% per_person = analysis[:per_person_strategies] || [] %>
  <% target_savings = analysis[:target_savings] || Setting.retirement_target_savings %>

  <% per_person.each do |person_data| %>
    <% strategies = person_data[:strategies] || [] %>
    <% sweet_spot = person_data[:sweet_spot] %>
    <% planned_date = person_data[:current_planned_date] %>
    <% center_idx = person_data[:center_index] || (strategies.size / 2) %>
    <% next if strategies.empty? %>

    <%
      # Default visible window: center the active tile with 2 on each side
      default_active = if sweet_spot
        strategies.index { |s| s[:date] == sweet_spot[:date] } || center_idx
      else
        center_idx
      end
      visible_start = [default_active - 2, 0].max
      visible_start = [visible_start, strategies.size - 5].min if strategies.size >= 5
      visible_start = [visible_start, 0].max
    %>

    <section class="bg-container shadow-border-xs rounded-xl p-4 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-medium text-primary"><%= person_data[:person_name] %></h3>
        <span class="text-xs text-secondary">Target savings: <%= format_money Money.new(target_savings, scenario.family.currency) %></span>
      </div>

      <!-- Planned date feedback -->
      <% if planned_date.present? %>
        <% planned_strategy = strategies.find { |s| s[:date] == planned_date } %>
        <% if planned_strategy && planned_strategy[:feasible] && planned_strategy[:success_rate].to_i >= 85 %>
          <div class="bg-green-50 border border-green-200 rounded-lg p-3 flex items-start gap-2">
            <%= icon("check-circle", size: "sm", class: "text-green-600 mt-0.5") %>
            <p class="text-sm text-green-800">
              Your planned date (<%= Date.parse(planned_date).strftime("%b %Y") %>) is feasible — ~<%= planned_strategy[:success_rate] %>% success
            </p>
          </div>
        <% else %>
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 flex items-start gap-2">
            <%= icon("triangle-alert", size: "sm", class: "text-yellow-600 mt-0.5") %>
            <div>
              <p class="text-sm font-medium text-yellow-800">
                Your planned date (<%= Date.parse(planned_date).strftime("%b %Y") %>)
                <% if planned_strategy %>
                  requires cashouts (<%= planned_strategy[:success_rate] %>% success)
                <% else %>
                  is not in the analyzed range
                <% end %>
              </p>
              <% if sweet_spot %>
                <p class="text-xs text-yellow-700">
                  Earliest feasible: <strong><%= sweet_spot[:label] %></strong> (<%= sweet_spot[:years_from_now] %> years from now)
                </p>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Interactive year selector -->
      <div data-controller="sweet-spot-selector"
           data-sweet-spot-selector-active-index-value="<%= default_active %>"
           data-sweet-spot-selector-visible-start-value="<%= visible_start %>"
           data-sweet-spot-selector-strategies-value="<%= strategies.to_json %>"
           data-sweet-spot-selector-person-id-value="<%= person_data[:person_id] %>"
           data-sweet-spot-selector-calculate-url-value="<%= calculate_sweet_spot_year_retirement_scenario_path(scenario) %>">

        <div class="flex items-center gap-2">
          <button class="p-2 rounded-lg hover:bg-surface-inset text-secondary shrink-0"
                  data-sweet-spot-selector-target="prevButton"
                  data-action="click->sweet-spot-selector#prev">
            <%= icon("chevron-left", size: "sm") %>
          </button>

          <div class="flex-1 flex items-end gap-2 justify-center"
               data-sweet-spot-selector-target="tilesContainer">
            <!-- Tiles rendered by Stimulus -->
          </div>

          <button class="p-2 rounded-lg hover:bg-surface-inset text-secondary shrink-0"
                  data-sweet-spot-selector-target="nextButton"
                  data-action="click->sweet-spot-selector#next">
            <%= icon("chevron-right", size: "sm") %>
          </button>
        </div>

        <!-- Detail panels: one per strategy, toggled by Stimulus -->
        <% strategies.each_with_index do |s, i| %>
          <div class="mt-4 space-y-3 <%= 'hidden' unless i == default_active %>"
               data-sweet-spot-selector-target="detail">

            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <% if s[:feasible] %>
                  <%= icon("check-circle", size: "sm", class: "text-green-600") %>
                <% else %>
                  <%= icon("x-circle", size: "sm", class: "text-red-500") %>
                <% end %>
                <h4 class="font-medium text-primary">Retire <%= s[:label] %></h4>
                <span class="text-xs text-secondary">(<%= s[:years_from_now] %> years from now)</span>
              </div>
              <span class="text-sm font-medium <%= s[:success_rate].to_i >= 85 ? 'text-green-600' : s[:success_rate].to_i >= 50 ? 'text-yellow-600' : 'text-red-500' %>">
                ~<%= s[:success_rate] %>% success
              </span>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div class="bg-surface-inset rounded-lg p-3">
                <p class="text-xs text-secondary">Gap Period</p>
                <p class="text-sm font-medium text-primary"><%= s[:gap_months] %> months</p>
              </div>
              <div class="bg-surface-inset rounded-lg p-3">
                <p class="text-xs text-secondary">Gap Cost</p>
                <p class="text-sm font-medium text-primary"><%= format_money Money.new(s[:gap_cost], scenario.family.currency) %></p>
              </div>
              <div class="bg-surface-inset rounded-lg p-3">
                <p class="text-xs text-secondary">Projected Savings</p>
                <p class="text-sm font-medium text-primary"><%= format_money Money.new(s[:projected_savings], scenario.family.currency) %></p>
              </div>
              <div class="bg-surface-inset rounded-lg p-3">
                <p class="text-xs text-secondary">Savings After Gap</p>
                <p class="text-sm font-medium <%= s[:savings_after_gap].to_f >= target_savings ? 'text-green-600' : 'text-red-600' %>">
                  <%= format_money Money.new(s[:savings_after_gap], scenario.family.currency) %>
                </p>
              </div>
            </div>

            <% if s[:shortfall].to_f > 0 && s[:cashout_plan]&.any? %>
              <div class="border-t border-divider pt-3 space-y-2">
                <p class="text-sm text-secondary">
                  Shortfall of <strong><%= format_money Money.new(s[:shortfall], scenario.family.currency) %></strong> — contracts to cash out:
                </p>
                <% s[:cashout_plan].each do |c| %>
                  <div class="flex items-center justify-between bg-surface-inset rounded-lg px-3 py-2">
                    <div class="flex items-center gap-2">
                      <%= icon("banknote", size: "sm", class: "text-blue-600") %>
                      <div>
                        <p class="text-sm font-medium text-primary"><%= c[:account_name] %></p>
                        <p class="text-xs text-secondary"><%= c[:subtype]&.to_s&.humanize %></p>
                      </div>
                    </div>
                    <div class="text-right">
                      <p class="text-sm font-medium text-primary">+<%= format_money Money.new(c[:cashout_value], scenario.family.currency) %></p>
                      <% if c[:lost_monthly_payout].to_f > 0 %>
                        <p class="text-xs text-red-500">-<%= format_money Money.new(c[:lost_monthly_payout], scenario.family.currency) %>/mo pension</p>
                      <% end %>
                    </div>
                  </div>
                <% end %>
                <div class="flex justify-between text-sm pt-2 border-t border-divider">
                  <span class="text-secondary">Total</span>
                  <span class="text-primary">
                    <strong>+<%= format_money Money.new(s[:total_cashout], scenario.family.currency) %></strong>
                    <% if s[:total_lost_pension].to_f > 0 %>
                      / <span class="text-red-500">-<%= format_money Money.new(s[:total_lost_pension], scenario.family.currency) %>/mo</span>
                    <% end %>
                  </span>
                </div>
              </div>
            <% elsif s[:gap_months].to_i > 0 %>
              <div class="flex items-center gap-2 text-sm text-green-600 border-t border-divider pt-3">
                <%= icon("check-circle", size: "sm") %>
                <span>Savings cover the gap without cashing out any contracts</span>
              </div>
            <% else %>
              <div class="flex items-center gap-2 text-sm text-green-600 border-t border-divider pt-3">
                <%= icon("check-circle", size: "sm") %>
                <span>No income gap — pensions start at or before retirement</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Try in Explorer -->
  <%
    explorer_params = {}
    per_person.each do |person_data|
      sweet = person_data[:sweet_spot]
      next unless sweet && person_data[:person_id]
      explorer_params["person_retirement_dates[#{person_data[:person_id]}]"] = sweet[:date]
      sweet[:cashout_plan]&.each do |c|
        next unless c[:pension_source_id].present?
        explorer_params["pension_payout_dates[#{c[:pension_source_id]}]"] = c[:cashout_date]
      end
    end
  %>
  <% if explorer_params.any? %>
    <section class="bg-blue-50 border border-blue-200 rounded-xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <%= icon("arrow-right-circle", size: "sm", class: "text-blue-600 shrink-0") %>
        <div>
          <p class="text-sm font-medium text-blue-800">Try recommended dates in the Explorer</p>
          <p class="text-xs text-blue-600">
            <% names = per_person.select { |p| p[:sweet_spot] }.map { |p| "#{p[:person_name]} (#{p[:sweet_spot][:label]})" } %>
            <%= names.join(", ") %>
          </p>
        </div>
      </div>
      <%= link_to retirement_scenario_path(scenario, explorer_params.merge(from_sweet_spot: true)),
          class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 shrink-0" do %>
        Try in Explorer
      <% end %>
    </section>
  <% end %>

  <% if scenario.sweet_spot_ran_at.present? %>
    <p class="text-xs text-subdued text-center">
      Analysis ran <%= time_ago_in_words(scenario.sweet_spot_ran_at) %> ago
    </p>
  <% end %>
</div>
