<%# locals: (scenario:) %>
<% future_milestones = scenario.future_milestones %>

<div class="bg-container rounded-xl p-6 shadow-border-xs">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-primary">Financial Milestones</h2>
  </div>

  <% if future_milestones.any? %>
    <div class="space-y-3">
      <% future_milestones.each do |milestone| %>
        <%
          type_config = {
            "debt_payoff" => { icon: "check-circle", color: "text-green-600", bg: "bg-green-500/10", border: "border-green-500/20" },
            "bauspar_phase_change" => { icon: "arrow-right-left", color: "text-blue-600", bg: "bg-blue-500/10", border: "border-blue-500/20" },
            "salary_change" => { icon: "trending-up", color: "text-purple-600", bg: "bg-purple-500/10", border: "border-purple-500/20" },
            "expense_change" => { icon: "receipt", color: "text-orange-600", bg: "bg-orange-500/10", border: "border-orange-500/20" },
            "income_start" => { icon: "plus-circle", color: "text-green-600", bg: "bg-green-500/10", border: "border-green-500/20" },
            "income_stop" => { icon: "minus-circle", color: "text-red-600", bg: "bg-red-500/10", border: "border-red-500/20" },
            "custom" => { icon: "flag", color: "text-secondary", bg: "bg-surface-inset", border: "border-secondary" }
          }
          config = type_config[milestone.milestone_type] || type_config["custom"]
        %>

        <div class="flex items-center gap-3 p-3 rounded-lg <%= config[:bg] %> border <%= config[:border] %>">
          <%= icon config[:icon], class: "w-5 h-5 #{config[:color]} shrink-0" %>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-primary truncate"><%= milestone.label %></span>
              <% if milestone.auto_detected? %>
                <span class="text-xs text-secondary bg-surface px-1.5 py-0.5 rounded">Auto</span>
              <% end %>
            </div>
            <span class="text-xs text-secondary"><%= milestone.date.strftime("%B %Y") %></span>
          </div>
          <% if milestone.amount.present? && milestone.amount > 0 %>
            <div class="text-right shrink-0">
              <span class="text-sm font-semibold <%= milestone.frees_cash_flow? ? "text-green-600" : "text-primary" %>">
                <% if milestone.frees_cash_flow? %>+<% end %><%= format_money Money.new(milestone.amount, scenario.family.currency) %>/mo
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="p-6 bg-surface-inset rounded-lg text-center">
      <p class="text-sm text-secondary">No upcoming milestones detected.</p>
      <p class="text-xs text-secondary mt-1">Add loan accounts with maturity dates or Bauspar contracts to see auto-detected milestones.</p>
    </div>
  <% end %>
</div>
