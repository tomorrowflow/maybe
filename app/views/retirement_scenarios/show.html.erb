<div class="space-y-6 max-w-5xl mx-auto">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-medium text-primary"><%= @scenario.name %></h1>
      <% unless @scenario.household? %>
        <div class="rounded-md bg-surface-inset px-2 py-0.5">
          <p class="uppercase text-secondary font-medium text-xs"><%= @scenario.scenario_type %></p>
        </div>
        <% if @scenario.personal? && @scenario.person.present? %>
          <span class="text-sm text-secondary"><%= @scenario.person.display_name %></span>
        <% elsif @scenario.joint? && @scenario.retirement_scenario_persons.any? %>
          <span class="text-sm text-secondary"><%= @scenario.retirement_scenario_persons.includes(:person).map { |rsp| rsp.person.first_name }.join(" & ") %></span>
        <% end %>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= render DS::Button.new(
        text: "Simulate",
        icon: "refresh-cw",
        variant: :outline,
        href: simulate_retirement_scenario_path(@scenario),
        method: :post
      ) %>
      <%= render DS::Link.new(
        text: "Edit",
        icon: "pencil",
        variant: :outline,
        href: edit_retirement_scenario_path(@scenario)
      ) %>
    </div>
  </div>

  <!-- Page Navigation -->
  <%= render "retirement_scenarios/page_nav", scenario: @scenario, active: :overview %>

  <!-- Monte Carlo Results -->
  <div id="monte-carlo-results-<%= @scenario.id %>">
    <%= turbo_stream_from @scenario.family %>
    <%= render "retirement_scenarios/monte_carlo_card", scenario: @scenario %>
  </div>

  <!-- Key Metrics -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
    <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 p-4">
      <h4 class="text-secondary text-sm">Portfolio</h4>
      <p class="text-xl font-medium text-primary"><%= format_money Money.new(@scenario.current_portfolio_value || 0, @scenario.family.currency) %></p>
    </div>
    <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 p-4">
      <h4 class="text-secondary text-sm">Monthly Pension Income</h4>
      <p class="text-xl font-medium text-primary"><%= format_money Money.new(@scenario.total_pension_income || 0, @scenario.family.currency) %></p>
    </div>
    <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 p-4">
      <h4 class="text-secondary text-sm">Monthly Expenses</h4>
      <p class="text-xl font-medium text-primary"><%= format_money Money.new(@scenario.retirement_monthly_expenses || 0, @scenario.family.currency) %></p>
    </div>
    <div class="rounded-xl bg-container shadow-xs border border-alpha-black-25 p-4">
      <h4 class="text-secondary text-sm">Monthly Savings</h4>
      <p class="text-xl font-medium text-primary"><%= format_money Money.new(@scenario.effective_monthly_savings, @scenario.family.currency) %></p>
    </div>
  </div>

  <!-- Explorer Panel -->
  <%= render "retirement_scenarios/explorer", scenario: @scenario %>

  <!-- Cash Flow Card -->
  <%= render "retirement_scenarios/cash_flow_card", scenario: @scenario %>

  <!-- Financial Milestones -->
  <%= render "retirement_scenarios/milestones_section", scenario: @scenario %>

  <!-- Income Breakdown -->
  <%= render "retirement_scenarios/income_breakdown", scenario: @scenario %>

  <!-- Footer -->
  <div class="text-center text-xs text-subdued pb-8">
    <% if @scenario.monte_carlo_ran_at.present? %>
      Last simulated: <%= @scenario.monte_carlo_ran_at.strftime("%B %d, %Y at %H:%M") %>
      &middot; <%= @scenario.monte_carlo_results.dig("simulation_count") || @scenario.simulation_count %> simulations
    <% end %>
  </div>
</div>
