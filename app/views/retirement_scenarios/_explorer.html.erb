<%# locals: (scenario:) %>
<%
  # Check for pre-filled values from sweet spot analysis
  from_sweet_spot = params[:from_sweet_spot] == "true" rescue false
  person_date_overrides = params[:person_retirement_dates]&.to_unsafe_h || {}
  pension_date_overrides = params[:pension_payout_dates]&.to_unsafe_h || {}
%>
<section class="bg-container shadow-border-xs rounded-xl p-4 space-y-4"
         data-controller="retirement-explorer"
         data-retirement-explorer-url-value="<%= explore_retirement_scenario_path(scenario) %>"
         data-retirement-explorer-apply-url-value="<%= apply_exploration_retirement_scenario_path(scenario) %>"
         data-retirement-explorer-auto-explore-value="<%= from_sweet_spot %>">

  <% if from_sweet_spot %>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 flex items-center gap-2 text-sm text-blue-800">
      <%= icon("sparkles", size: "sm", class: "text-blue-600") %>
      Sweet spot recommendations applied — review and adjust below, then click "Apply Changes" to save.
    </div>
  <% end %>

  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-medium text-primary">What-If Explorer</h2>
      <p class="text-sm text-secondary">Adjust parameters to see how they affect your probability</p>
    </div>
    <button class="hidden px-3 py-1.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700"
            data-retirement-explorer-target="applyButton"
            data-action="click->retirement-explorer#apply">
      Apply Changes
    </button>
  </div>

  <!-- Core Parameters -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="form-field">
      <label class="form-field__label">Monthly Retirement Expenses</label>
      <input type="number" min="0" step="100"
             value="<%= scenario.retirement_monthly_expenses&.to_i %>"
             class="form-field__input"
             data-retirement-explorer-target="expenseInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>

    <div class="form-field">
      <label class="form-field__label">Monthly Contribution</label>
      <input type="number" min="0" step="50"
             value="<%= (scenario.monthly_contribution || scenario.effective_monthly_savings).to_i %>"
             class="form-field__input"
             data-retirement-explorer-target="contributionInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>

    <div class="form-field">
      <label class="form-field__label">Plan Through Age</label>
      <input type="number" min="60" max="120" step="1"
             value="<%= scenario.target_age %>"
             class="form-field__input"
             data-retirement-explorer-target="targetAgeInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>

    <div class="form-field">
      <label class="form-field__label">Expected Return (%)</label>
      <input type="number" min="-20" max="50" step="0.5"
             value="<%= scenario.portfolio_growth_rate %>"
             class="form-field__input"
             data-retirement-explorer-target="growthRateInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>
  </div>

  <!-- Per-Person Retirement Dates -->
  <% persons = scenario.retirement_scenario_persons.includes(:person) %>
  <% if persons.any? %>
    <div class="border-t border-divider pt-4 space-y-3">
      <p class="text-sm font-medium text-primary">Retirement Dates</p>
      <div class="grid grid-cols-1 md:grid-cols-<%= [persons.size, 3].min %> gap-4">
        <% persons.each do |rsp| %>
          <% override_date = person_date_overrides[rsp.id.to_s] %>
          <div class="form-field <%= 'ring-2 ring-blue-300' if override_date %>">
            <label class="form-field__label"><%= rsp.person.display_name %> stops working</label>
            <input type="date"
                   value="<%= override_date || rsp.salary_end_date&.iso8601 %>"
                   class="form-field__input"
                   data-retirement-explorer-target="personDate"
                   data-person-id="<%= rsp.id %>"
                   data-action="input->retirement-explorer#paramChanged">
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Pension Payout Dates -->
  <% pensions = scenario.pension_sources.with_payout.includes(:account) %>
  <% if pensions.any? %>
    <div class="border-t border-divider pt-4 space-y-3">
      <p class="text-sm font-medium text-primary">Pension Payout Start Dates</p>
      <div class="grid grid-cols-1 md:grid-cols-<%= [pensions.size, 3].min %> gap-4">
        <% pensions.each do |ps| %>
          <% override_date = pension_date_overrides[ps.id.to_s] %>
          <div class="form-field <%= 'ring-2 ring-blue-300' if override_date %>">
            <label class="form-field__label"><%= ps.account.name %></label>
            <input type="date"
                   value="<%= override_date || ps.payout_start_date&.iso8601 %>"
                   class="form-field__input"
                   data-retirement-explorer-target="pensionDate"
                   data-pension-id="<%= ps.id %>"
                   data-action="input->retirement-explorer#paramChanged">
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Explored results area (updated via Turbo Stream) -->
  <div id="explore-results-<%= scenario.id %>" class="hidden border-t border-divider pt-4"
       data-retirement-explorer-target="results">
    <div class="flex items-center gap-2">
      <div class="animate-spin text-secondary hidden" data-retirement-explorer-target="loadingIndicator">
        <%= icon("loader-2", size: "sm") %>
      </div>
      <p class="text-sm text-secondary" data-retirement-explorer-target="exploredRate">-</p>
    </div>
  </div>
</section>
