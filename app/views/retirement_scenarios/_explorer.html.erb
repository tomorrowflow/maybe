<%# locals: (scenario:) %>
<section class="bg-container shadow-border-xs rounded-xl p-4 space-y-4"
         data-controller="retirement-explorer"
         data-retirement-explorer-url-value="<%= explore_retirement_scenario_path(scenario) %>"
         data-retirement-explorer-apply-url-value="<%= apply_exploration_retirement_scenario_path(scenario) %>">

  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-medium text-primary">What-If Explorer</h2>
      <p class="text-sm text-secondary">Adjust parameters to see how they affect your probability</p>
    </div>
    <button class="hidden px-3 py-1.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700"
            data-retirement-explorer-target="applyButton"
            data-action="click->retirement-explorer#apply">
      Apply Changes
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="form-field">
      <label class="form-field__label">Monthly Retirement Expenses</label>
      <input type="number" min="0" step="100"
             value="<%= scenario.retirement_monthly_expenses&.to_i %>"
             class="form-field__input"
             data-retirement-explorer-target="expenseInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>

    <div class="form-field">
      <label class="form-field__label">Monthly Contribution</label>
      <input type="number" min="0" step="50"
             value="<%= (scenario.monthly_contribution || scenario.effective_monthly_savings).to_i %>"
             class="form-field__input"
             data-retirement-explorer-target="contributionInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>

    <div class="form-field">
      <label class="form-field__label">Plan Through Age</label>
      <input type="number" min="60" max="120" step="1"
             value="<%= scenario.target_age %>"
             class="form-field__input"
             data-retirement-explorer-target="targetAgeInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>

    <div class="form-field">
      <label class="form-field__label">Expected Return (%)</label>
      <input type="number" min="-20" max="50" step="0.5"
             value="<%= scenario.portfolio_growth_rate %>"
             class="form-field__input"
             data-retirement-explorer-target="growthRateInput"
             data-action="input->retirement-explorer#paramChanged">
    </div>
  </div>

  <!-- Explored results area (updated via Turbo Stream) -->
  <div id="explore-results-<%= scenario.id %>" class="hidden border-t border-divider pt-4"
       data-retirement-explorer-target="results">
    <div class="flex items-center gap-2">
      <div class="animate-spin text-secondary hidden" data-retirement-explorer-target="loadingIndicator">
        <%= icon("loader-2", size: "sm") %>
      </div>
      <p class="text-sm text-secondary" data-retirement-explorer-target="exploredRate">-</p>
    </div>
  </div>
</section>
