<%# locals: (scenario:, active:) %>
<%
  tabs = [
    { key: :overview, label: "Overview", icon: "layout-dashboard", path: retirement_scenario_path(scenario) },
    { key: :income_timeline, label: "Income Timeline", icon: "trending-up", path: income_timeline_retirement_scenario_path(scenario) },
    { key: :portfolio, label: "Portfolio Projection", icon: "bar-chart-3", path: portfolio_retirement_scenario_path(scenario) },
    { key: :snapshots, label: "Snapshots", icon: "camera", path: snapshots_retirement_scenario_path(scenario) },
    { key: :sweet_spot, label: "Sweet Spot", icon: "target", path: sweet_spot_retirement_scenario_path(scenario) }
  ]
%>
<nav class="flex items-center gap-1 bg-container-inset rounded-lg p-1">
  <% tabs.each do |tab| %>
    <% is_active = tab[:key] == active %>
    <%= link_to tab[:path],
        class: "flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium transition-colors #{is_active ? 'bg-container shadow-xs text-primary' : 'text-secondary hover:text-primary'}" do %>
      <%= icon(tab[:icon], size: "sm") %>
      <span class="hidden md:inline"><%= tab[:label] %></span>
    <% end %>
  <% end %>
</nav>
