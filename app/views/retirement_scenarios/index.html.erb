<div class="space-y-4 pb-20 flex flex-col">
  <header class="flex justify-between items-center text-primary font-medium">
    <h1 class="text-xl">Retirement Planning</h1>
    <div class="flex items-center gap-2">
      <%= render DS::Link.new(
        text: "New Plan",
        icon: "plus",
        variant: "primary",
        href: new_retirement_scenario_path,
        class: "hidden md:inline-flex"
      ) %>
      <%= render DS::Link.new(
        icon: "plus",
        variant: "icon-inverse",
        href: new_retirement_scenario_path,
        class: "rounded-full md:hidden"
      ) %>
    </div>
  </header>

  <% if @scenarios.any? %>
    <!-- Primary Scenario Summary -->
    <% if @primary_scenario %>
      <section class="bg-container shadow-border-xs rounded-xl p-6 space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-medium text-primary"><%= @primary_scenario.name %></h2>
            <span class="bg-blue-100 text-blue-700 text-xs font-medium px-2 py-0.5 rounded">Primary</span>
          </div>
          <%= render DS::Link.new(
            text: "View",
            variant: :outline,
            href: retirement_scenario_path(@primary_scenario)
          ) %>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div>
            <p class="text-xs text-secondary">Success Probability</p>
            <%
              rate = @primary_scenario.monte_carlo_success_rate&.to_i
              if rate
                color_class = rate >= 80 ? "text-green-600" : rate >= 50 ? "text-yellow-600" : "text-red-600"
              end
            %>
            <p class="text-xl font-bold <%= color_class %>">
              <%= rate ? "~#{rate}%" : "—" %>
            </p>
          </div>
          <div>
            <p class="text-xs text-secondary">Portfolio</p>
            <p class="text-xl font-medium text-primary"><%= format_money Money.new(@primary_scenario.current_portfolio_value || 0, @primary_scenario.family.currency) %></p>
          </div>
          <div>
            <p class="text-xs text-secondary">Monthly Expenses</p>
            <p class="text-xl font-medium text-primary"><%= format_money Money.new(@primary_scenario.retirement_monthly_expenses || 0, @primary_scenario.family.currency) %></p>
          </div>
          <div>
            <p class="text-xs text-secondary">Target Age</p>
            <p class="text-xl font-medium text-primary"><%= @primary_scenario.target_age %></p>
          </div>
        </div>
      </section>
    <% end %>

    <!-- Scenario List -->
    <div class="bg-container rounded-xl shadow-border-xs">
      <div class="p-4 space-y-1">
        <% @scenarios.each do |scenario| %>
          <%= link_to retirement_scenario_path(scenario),
              class: "flex items-center justify-between px-4 py-3 rounded-lg hover:bg-container-hover" do %>
            <div class="flex items-center gap-3">
              <%
                rate = scenario.monte_carlo_success_rate&.to_i
                bg = if rate.nil?
                  "bg-surface-inset"
                elsif rate >= 80
                  "bg-green-100"
                elsif rate >= 50
                  "bg-yellow-100"
                else
                  "bg-red-100"
                end
              %>
              <div class="w-10 h-10 rounded-full <%= bg %> flex items-center justify-center">
                <% if rate %>
                  <span class="text-xs font-bold"><%= rate %>%</span>
                <% else %>
                  <%= icon("calculator", size: "sm", class: "text-secondary") %>
                <% end %>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <p class="text-sm font-medium text-primary"><%= scenario.name %></p>
                  <% if scenario.is_primary %>
                    <span class="bg-blue-100 text-blue-700 text-[10px] font-medium px-1.5 py-0.5 rounded">Primary</span>
                  <% end %>
                  <% unless scenario.household? %>
                    <span class="text-[10px] text-secondary uppercase"><%= scenario.scenario_type %></span>
                  <% end %>
                </div>
                <p class="text-xs text-secondary">
                  <% if scenario.monte_carlo_ran_at %>
                    Last simulated <%= time_ago_in_words(scenario.monte_carlo_ran_at) %> ago
                  <% else %>
                    Not yet simulated
                  <% end %>
                </p>
              </div>
            </div>

            <div class="hidden md:flex items-center gap-6 text-sm">
              <div class="text-right">
                <p class="text-secondary text-xs">Expenses</p>
                <p class="font-medium text-primary"><%= format_money Money.new(scenario.retirement_monthly_expenses || 0, scenario.family.currency) %>/mo</p>
              </div>
              <div class="text-right">
                <p class="text-secondary text-xs">Target</p>
                <p class="font-medium text-primary">Age <%= scenario.target_age %></p>
              </div>
              <%= icon("chevron-right", size: "sm", class: "text-secondary") %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

  <% else %>
    <!-- Empty State -->
    <div class="flex justify-center items-center h-[400px] text-sm">
      <div class="text-center flex flex-col items-center max-w-[300px]">
        <p class="text-primary mb-1 font-medium">No retirement plans yet</p>
        <p class="text-secondary mb-4">Create your first plan to start modeling your retirement.</p>
        <%= render DS::Link.new(
          text: "Create Plan",
          href: new_retirement_scenario_path,
          variant: :primary
        ) %>
      </div>
    </div>
  <% end %>
</div>
