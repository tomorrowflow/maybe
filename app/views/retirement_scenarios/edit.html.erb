<%= content_for :header_nav do %>
  <%= render "retirement_scenarios/wizard_nav", current_step: @step %>
<% end %>

<%= content_for :prev_nav do %>
  <button type="button"
          class="inline-flex items-center justify-center w-9 h-9 rounded-lg hover:bg-gray-100 theme-dark:hover:bg-gray-700"
          onclick="document.dispatchEvent(new CustomEvent('retirement-wizard:back'))">
    <%= icon "arrow-left", class: "w-5 h-5 text-secondary" %>
  </button>
<% end %>

<%= content_for :cancel_path, retirement_scenario_path(@scenario) %>

<div data-controller="retirement-wizard"
     data-retirement-wizard-current-step-value="<%= @step %>"
     data-retirement-wizard-exit-path-value="<%= retirement_scenario_path(@scenario) %>">
  <div class="space-y-4">
    <%= styled_form_with model: @scenario, url: retirement_scenario_path(@scenario), method: :patch, class: "space-y-6" do |form| %>
      <!-- Step 1: Basics -->
      <div data-retirement-wizard-target="step" data-step="basics" class="<%= "hidden" unless @step == "basics" %>">
        <div class="text-center space-y-2 mb-8">
          <h1 class="text-3xl text-primary font-medium"><%= t(".basics.title") %></h1>
          <p class="text-secondary text-sm max-w-md mx-auto">
            <%= t(".basics.subtitle") %>
          </p>
        </div>

        <div class="mx-auto max-w-lg space-y-4">
          <%= form.text_field :name,
                              label: t("retirement_scenarios.form.plan_name"),
                              placeholder: t("retirement_scenarios.form.plan_name_placeholder"),
                              required: true %>

          <%= form.number_field :retirement_monthly_expenses,
                                label: t("retirement_scenarios.form.monthly_expenses"),
                                placeholder: "4000",
                                min: 0,
                                step: 1,
                                required: true %>

          <div class="border border-tertiary rounded-lg p-4 flex gap-3">
            <%= icon "info", class: "w-5 h-5 text-secondary shrink-0 mt-0.5" %>
            <div class="space-y-1 text-sm">
              <h4 class="text-primary font-medium"><%= t("retirement_scenarios.form.monthly_expenses_info_title") %></h4>
              <p class="text-secondary">
                <%= t("retirement_scenarios.form.monthly_expenses_info_text") %>
              </p>
            </div>
          </div>

          <div class="pt-4">
            <button type="button"
                    class="font-medium whitespace-nowrap inline-flex items-center gap-1 rounded-lg w-full justify-center px-3 py-2 text-sm text-inverse bg-inverse hover:bg-inverse-hover"
                    data-action="click->retirement-wizard#nextStep"
                    data-wizard-next-step="cashflow">
              <%= t("retirement_scenarios.form.continue") %>
            </button>
          </div>
        </div>
      </div>

      <!-- Step 2: Cash Flow Analysis -->
      <div data-retirement-wizard-target="step" data-step="cashflow" class="<%= "hidden" unless @step == "cashflow" %>">
        <div class="text-center space-y-2 mb-8">
          <h1 class="text-3xl text-primary font-medium">Analyze Your Cash Flow</h1>
          <p class="text-secondary text-sm max-w-md mx-auto">
            We'll analyze your transaction history to understand your income, expenses, and recurring payments.
          </p>
        </div>

        <%= render "retirement_scenarios/cashflow_step", form: form, scenario: @scenario, analysis: @analysis %>
      </div>

      <!-- Step 3: Income -->
      <div data-retirement-wizard-target="step" data-step="income" class="<%= "hidden" unless @step == "income" %>">
        <div class="text-center space-y-2 mb-8">
          <h1 class="text-3xl text-primary font-medium"><%= t(".income.title") %></h1>
          <p class="text-secondary text-sm max-w-md mx-auto">
            <%= t(".income.subtitle") %>
          </p>
        </div>

        <%= render "retirement_scenarios/income_step", form: form, scenario: @scenario %>
      </div>

      <!-- Step 3: Portfolio -->
      <div data-retirement-wizard-target="step" data-step="portfolio" class="<%= "hidden" unless @step == "portfolio" %>">
        <div class="text-center space-y-2 mb-8">
          <h1 class="text-3xl text-primary font-medium"><%= t(".portfolio.title") %></h1>
          <p class="text-secondary text-sm max-w-md mx-auto">
            <%= t(".portfolio.subtitle") %>
          </p>
        </div>

        <div class="mx-auto max-w-lg space-y-4">
          <p class="text-sm font-medium text-primary mb-3">Monte Carlo Simulation Parameters</p>

          <div class="grid grid-cols-2 gap-4">
            <%= form.number_field :portfolio_growth_rate,
                                  label: "Expected Annual Return (%)",
                                  placeholder: "7.0",
                                  step: 0.5,
                                  min: -20,
                                  max: 50 %>

            <%= form.number_field :portfolio_growth_std_dev,
                                  label: "Return Volatility (%)",
                                  placeholder: "15.0",
                                  step: 0.5,
                                  min: 0,
                                  max: 50 %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <%= form.number_field :inflation_rate,
                                  label: "Expected Inflation (%)",
                                  placeholder: "3.0",
                                  step: 0.1,
                                  min: 0,
                                  max: 20 %>

            <%= form.number_field :target_age,
                                  label: "Plan Through Age",
                                  placeholder: "90",
                                  step: 1,
                                  min: 60,
                                  max: 120 %>
          </div>

          <%= form.number_field :monthly_contribution,
                                label: "Monthly Contribution (optional)",
                                placeholder: "Auto-calculated from savings",
                                min: 0,
                                step: 10 %>
          <p class="text-xs text-secondary mt-1">Leave blank to auto-calculate from your monthly savings.</p>

          <div class="border border-blue-200 bg-blue-50 theme-dark:border-blue-800 theme-dark:bg-blue-900/20 rounded-lg p-4 flex gap-3">
            <%= icon "bar-chart-3", class: "w-5 h-5 text-blue-600 shrink-0 mt-0.5" %>
            <div class="space-y-1 text-sm">
              <h4 class="text-primary font-medium">Monte Carlo Simulation</h4>
              <p class="text-secondary">
                We run 1,000 randomized market scenarios to calculate the probability that your money
                lasts through your target age. Higher volatility means more uncertainty in outcomes.
              </p>
            </div>
          </div>

          <div class="pt-4">
            <%= form.submit "Save Changes" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
